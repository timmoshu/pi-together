exports[`operational diagnostics > keeps the complete failure/remediation catalog stable > doctor failure catalog 1`] = `
[
  {
    "code": "PTD-CONFIG",
    "remediation": "Re-run setup after correcting config ownership, mode, or schema.",
    "status": "fail",
    "summary": "Configuration is missing, unsafe, or invalid.",
  },
  {
    "code": "PTD-RELEASE",
    "remediation": "Reinstall the exact signed release before starting services.",
    "status": "fail",
    "summary": "Installed release integrity could not be verified.",
  },
  {
    "code": "PTD-PI-VERSION",
    "remediation": "Install a Pi version in the supported range >=0.82.0 <0.84.0.",
    "status": "fail",
    "summary": "Installed Pi version is unsupported or invalid.",
  },
  {
    "code": "PTD-PI-MODELS",
    "remediation": "Configure at least one Pi model and rerun doctor.",
    "status": "fail",
    "summary": "Pi reported no model entries.",
  },
  {
    "code": "PTD-WORKSPACES",
    "remediation": "Restore each configured canonical shared repository folder and invoking-user ownership.",
    "status": "fail",
    "summary": "One or more shared repository folders are unavailable or wrongly owned.",
  },
  {
    "code": "PTD-IDENTITY",
    "remediation": "Re-run setup to refresh and reconcile GitHub numeric principal mappings.",
    "status": "fail",
    "summary": "A GitHub mapping is stale, unavailable, or no longer matches its numeric subject.",
  },
  {
    "code": "PTD-DNS",
    "remediation": "Point the public domain at this host, wait for propagation, then rerun doctor.",
    "status": "fail",
    "summary": "Public domain does not resolve.",
  },
  {
    "code": "PTD-LISTENER",
    "remediation": "Start the app on its configured private socket or literal loopback listener.",
    "status": "fail",
    "summary": "Configured private listener is unavailable or unsafe.",
  },
  {
    "code": "PTD-PORTS",
    "remediation": "Restore nginx on ports 80/443 and keep oauth2-proxy on literal loopback only.",
    "status": "fail",
    "summary": "Required ports are missing or oauth2-proxy is broadly bound.",
  },
  {
    "code": "PTD-SERVICES",
    "remediation": "Inspect the named owned units with pi-together logs and restart only after correction.",
    "status": "fail",
    "summary": "One or more owned service dependencies are inactive.",
  },
  {
    "code": "PTD-PROCESS-USERS",
    "remediation": "Restart owned services from the generated units and ensure neither runs as root.",
    "status": "fail",
    "summary": "An owned application process is missing or running as root.",
  },
  {
    "code": "PTD-CERTIFICATE",
    "remediation": "Renew or reissue the domain certificate before exposing the service.",
    "status": "fail",
    "summary": "Certificate is missing, untrusted, mismatched, or expires within 30 days.",
  },
  {
    "code": "PTD-RENEWAL",
    "remediation": "Enable and start certbot.timer and validate the Pi Together deploy hook.",
    "status": "fail",
    "summary": "Certbot renewal timer is not enabled and active.",
  },
  {
    "code": "PTD-PRIVATE-HEALTH",
    "remediation": "Restore the private app listener and configuration before public activation.",
    "status": "fail",
    "summary": "Authenticated private health check failed.",
  },
  {
    "code": "PTD-PUBLIC-REDIRECT",
    "remediation": "Verify nginx/oauth2-proxy routing and the configured OAuth callback URL.",
    "status": "fail",
    "summary": "Public OAuth redirect shape is invalid.",
  },
]
`;

